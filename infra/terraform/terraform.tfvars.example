# terraform.tfvars のテンプレート。実際の値でコピーして使う。
aws_region        = "ap-northeast-1"
project           = "cftraining"
environment       = "dev"
github_repository = "rice-3/cf"

# 任意（既定値あり）
# vpc_cidr          = "10.20.0.0/16"
# az_count          = 2
# desired_count     = 2
# db_instance_class = "db.t4g.micro"
# cognito_issuer    = "https://cognito-idp.ap-northeast-1.amazonaws.com/xxxxx"

# HTTPS / ドメイン（設定するとACM + HTTPS(443)を有効化）
# domain_name       = "cf.example.com"
# route53_zone_id   = "Z0123456789ABCDEFGHIJ"   # あればACM検証を自動化

# SES送信ドメイン（設定するとドメインID・DKIMを作成）
# ses_domain        = "example.com"
# ses_from_address  = "no-reply@example.com"   # 未指定なら no-reply@<ses_domain> を導出

# ECS起動猶予（Spring Boot起動 + Flyway移行がALBヘルスチェックに間に合わない場合に延長）
# health_check_grace_period_seconds = 180

# ECS Exec（Private配置RDSへのSSMポートフォワード経路）。
# 無指定なら environment から決まる（production は false、dev/staging は true）。
# production で保守のため一時的に開けるときだけ true を書き、作業後に必ず消して apply し直す。
# enable_ecs_exec   = true

# WAF
# enable_waf        = true
# waf_rate_limit    = 2000

# Cognito App Client のURL（本番ドメインに合わせる）
# cognito_callback_urls = ["https://cf.example.com/api/auth/callback/cognito"]
# cognito_logout_urls   = ["https://cf.example.com"]
